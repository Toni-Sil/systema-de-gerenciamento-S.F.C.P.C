# =============================================================================
# S.F.C.P.C - Environment Variables
# Copy this file to .env and fill in the values before running the application.
# NEVER commit your .env file to version control.
# =============================================================================

# --- Security (REQUIRED) ---
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_strong_random_key

# Token expiration in seconds (default: 3600 = 1 hour)
ACCESS_TOKEN_EXPIRE_SECONDS=3600

# --- Database (REQUIRED) ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://sfcpc_user:sfcpc_pass@localhost:5432/sfcpc_db

# --- Messaging (optional - app runs without Kafka in mock mode) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- LLM (optional - agent uses mock fallback if not set) ---
OPENAI_API_KEY=
HUGGINGFACE_TOKEN=
LLM_MODEL=llama3

# --- Observability ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOG_LEVEL=INFO
