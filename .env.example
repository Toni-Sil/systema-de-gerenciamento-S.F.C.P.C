# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env no repositório.

# JWT — gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=substitua-por-um-valor-aleatorio-de-64-chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# App
APP_TITLE=S.F.C.P.C - Systema de Gerenciamento
APP_VERSION=0.1.0
ENVIRONMENT=development
