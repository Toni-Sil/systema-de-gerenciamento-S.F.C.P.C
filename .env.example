# ============================================================
# S.F.C.P.C — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ----- Security (REQUIRED) -----
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-me-with-a-strong-random-secret

# Token expiry in seconds (default: 3600 = 1 hour)
ACCESS_TOKEN_EXPIRE_SECONDS=3600

# ----- Database (REQUIRED) -----
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://sfcpc:sfcpc@localhost:5432/sfcpc

# ----- CORS -----
# Comma-separated list of allowed origins, or * for development only
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# ----- Messaging (choose one) -----
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ----- LLM (optional) -----
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=sk-...

# ----- WhatsApp / Evolution API -----
# URL da sua instancia Evolution API no VPS
EVOLUTION_API_URL=https://evolution.seudominio.com
# API Key gerada nas configuracoes da Evolution API
EVOLUTION_API_KEY=your-evolution-api-key
# Nome da instancia criada na Evolution API
EVOLUTION_INSTANCE=sfcpc
# Numero do gestor que recebe os relatorios (formato: 5511999990000@s.whatsapp.net)
WHATSAPP_MANAGER_JID=5511999990000@s.whatsapp.net
# Nome da empresa exibido nos relatorios
COMPANY_NAME=S.F.C.P.C

# ----- Observability -----
# PROMETHEUS_ENABLED=true
# GRAFANA_URL=http://localhost:3001
